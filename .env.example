# Text Extractor Environment Configuration
# Copy this file to .env and adjust variables as needed

# Host and port configuration
HOST=127.0.0.1
PORT=8765

# Security settings
# Set ALLOW_REMOTE=1 to allow connections from other machines or public domains.
# NOTE: The service has no authentication by default. Only expose it on trusted networks.
ALLOW_REMOTE=0

# Number of reverse proxies in front of this application (e.g., Nginx, Cloudflare, Traefik, Render).
# Set to 1 (or higher) to properly resolve client IPs and Host headers via X-Forwarded-* headers.
TRUSTED_PROXIES=0

# Job & File Processing Limits
MAX_UPLOAD_MB=200
MAX_FILES=30
OCR_WORKERS=1
OCR_TIMEOUT_SECONDS=180
JOB_TTL_SECONDS=7200
MAX_JOBS_KEPT=20

# Custom Tesseract training data directory (optional)
# TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# Browser behavior (for CLI only: 1 to disable automatic browser opening)
# NO_BROWSER=0
